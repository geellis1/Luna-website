# Copy to .env (never commit .env) and set the same values in Vercel → Project → Settings → Environment Variables.
# See docs/CONTACT_FORM_SETUP.md.

# Resend API key (required)
RESEND_API_KEY=re_xxxxxxxxxxxx

# Google Sheets logging: the Apps Script web app URL and its shared secret
SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/xxxxxxxx/exec
SHEETS_WEBHOOK_SECRET=

# Optional overrides (these are the defaults)
# CONTACT_TO_EMAIL=kelli@lunacivicstrategies.com
# CONTACT_FROM_EMAIL=Luna Civic Strategies <website@lunacivicstrategies.com>
